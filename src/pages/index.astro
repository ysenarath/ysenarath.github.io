---
import Layout from "../layouts/Layout.astro";
import PageNav from "../components/PageNav.astro";
import {
    education,
    experience,
    funding,
    mentorship,
    service,
} from "../data/cv";
import { tutorials, assistantships, instructorships } from "../data/teaching";

const navItems = [
    { label: "About", href: "#about" },
    { label: "Education", href: "#education" },
    { label: "Experience", href: "#experience" },
    { label: "Teaching", href: "#teaching" },
    { label: "Mentorship", href: "#mentorship" },
    { label: "Grants", href: "#grants" },
    { label: "Service", href: "#service" },
];

const keywords = [
    "Continual Learning",
    "Human-Centered AI",
    "Streaming Data Analytics",
    "Neuro-symbolic AI",
    "Crisis Informatics",
];
---

<Layout title="About">
    <PageNav slot="page-nav" items={navItems} />
    <div slot="hero" class="border-b border-border">
        <div
            class="max-w-[1120px] mx-auto px-4 pt-12 pb-10 flex flex-wrap items-center gap-x-8 gap-y-6 max-sm:pt-8"
        >
            <img
                src="/profile-picture.png"
                alt="Yasas Senarath Wijesuriya"
                class="w-[128px] h-[128px] rounded-full object-cover border border-border shrink-0 max-sm:w-[96px] max-sm:h-[96px]"
            />
            <div class="flex flex-col gap-3 min-w-0 max-w-[44rem]">
                <h1>Yasas Senarath Wijesuriya</h1>
                <p class="m-0 text-[1.05rem] text-ink-muted">
                    PhD &middot; School of Computing, George Mason University
                </p>
                <ul
                    class="list-none p-0 m-0 flex flex-wrap gap-x-5 gap-y-1"
                    aria-label="Research interests"
                >
                    {
                        keywords.map((kw) => (
                            <li class="label">{kw}</li>
                        ))
                    }
                </ul>
                <p
                    class="m-0 text-[0.9rem] text-ink-muted flex flex-wrap items-center gap-x-[0.5rem] gap-y-1"
                >
                    <a href="mailto:yasas.mason@gmail.com">yasas.mason [at] gmail.com</a>
                    <span class="text-ink-ghost">&middot;</span>
                    <a href="/curriculum-vitae.pdf" target="_blank" rel="noopener"
                        >Curriculum Vitae</a
                    >
                    <span class="text-ink-ghost">&middot;</span>
                    Fairfax, VA
                </p>
            </div>
        </div>
    </div>

    <section id="about">
        <h2>About</h2>

        <p>
            I recently completed my PhD in the School of Computing at George
            Mason University, advised by <a
                href="https://mason.gmu.edu/~hpurohit/">Dr. Hemant Purohit</a
            >. The central theme of my research is <em
                >structured knowledge integration for robust and adaptive AI</em
            > — building systems that can adapt to real-world dynamic environments
            with the support of structured knowledge, bridging the gap between static
            model assumptions and the ever-changing nature of real-world data.
        </p>
        <p>
            My dissertation develops the Knowledge-Guided Continual Learning
            (KGCL) framework, which models evolving human behavioral patterns in
            online data streams by integrating external knowledge graphs into
            continual learning models, enabling AI systems to detect behavioral
            shifts through NLP tasks such as intent detection, sentiment
            analysis, and hate speech detection while mitigating catastrophic
            forgetting.
        </p>
        <p>
            Beyond the dissertation, my work spans emergency incident detection
            from crowdsourced data, human-AI teaming for crisis response, and
            real-time social media analytics for violence prevention, in
            collaboration with government agencies and international research
            partners.
        </p>
        <p>
            Before joining GMU, I completed an MSc (Research) and BSc in
            Engineering (First Class Honours) at the University of Moratuwa, Sri
            Lanka, where I worked on affect-level opinion mining and transfer
            learning for social media analytics.
        </p>
    </section>

    <section id="education">
        <h2>Education</h2>

        <div class="flex flex-col gap-4">
            {
                education.map((e) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {e.degree}
                            </div>
                            <div class="item-meta">
                                <em>{e.institution}</em>, {e.location}
                                {e.concentration && (
                                    <span> · {e.concentration}</span>
                                )}
                            </div>
                            {(e.thesis || e.advisor || e.gpa) && (
                                <div class="item-meta mt-[0.15rem]">
                                    {e.thesis && (
                                        <div>
                                            Thesis: <em>{e.thesis}</em>
                                        </div>
                                    )}
                                    {e.advisor && (
                                        <div>Advisor: {e.advisor}</div>
                                    )}
                                    {e.gpa && <div>GPA: {e.gpa}</div>}
                                </div>
                            )}
                        </div>
                        <div class="item-date">
                            {e.date}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="experience">
        <h2>Experience</h2>

        <div class="flex flex-col gap-4">
            {
                experience.map((e) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {e.organization}
                            </div>
                            <div class="item-meta mt-[0.15rem]">
                                {e.description}
                            </div>
                        </div>
                        <div class="item-date">
                            {e.period}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="teaching">
        <h2>Teaching</h2>

        <div class="flex flex-col gap-4 mb-4">
            {
                tutorials.map((t) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {t.title}
                            </div>
                            <div class="item-meta">
                                <em>{t.event}</em>
                                {t.location && <span> · {t.location}</span>}
                                {t.status && (
                                    <span class="tag">
                                        {t.status}
                                    </span>
                                )}
                                {t.presenters && (
                                    <>
                                        <br />
                                        <span class="italic">
                                            with{" "}
                                            {t.presenters
                                                .filter(
                                                    (p) =>
                                                        p !==
                                                        "Yasas Senarath Wijesuriya",
                                                )
                                                .join(", ")}
                                        </span>
                                    </>
                                )}
                            </div>
                        </div>
                        <div>
                            {t.year && (
                                <span class="item-date">{t.year}</span>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="flex flex-col gap-4 mb-4">
            {
                assistantships.map((a) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {a.role}
                            </div>
                            <div class="item-meta">
                                <em>{a.institution}</em>
                                {a.location && <span>, {a.location}</span>}
                            </div>
                            {a.courses && a.courses.length > 0 && (
                                <ul class="list-none p-0 mt-1 item-meta mb-0">
                                    {a.courses.map((course) => (
                                        <li class="mb-0.5">{course}</li>
                                    ))}
                                </ul>
                            )}
                        </div>
                        <div>
                            {a.period && (
                                <span class="item-date">
                                    {a.period}
                                </span>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="flex flex-col gap-4">
            {
                instructorships.map((i) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {i.role}
                            </div>
                            <div class="item-meta">
                                <em>{i.institution}</em>
                                {i.location && <span>, {i.location}</span>}
                            </div>
                            {i.courses && i.courses.length > 0 && (
                                <ul class="list-none p-0 mt-1 item-meta mb-0">
                                    {i.courses.map((course) => (
                                        <li class="mb-0.5">{course}</li>
                                    ))}
                                </ul>
                            )}
                        </div>
                        <div>
                            {i.period && (
                                <span class="item-date">
                                    {i.period}
                                </span>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="mentorship">
        <h2>Mentorship</h2>
        <div class="flex flex-col gap-4">
            {
                mentorship.map((m) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {m.name}
                            </div>
                            <div class="item-meta">
                                {m.type}
                            </div>
                        </div>
                        <div class="item-date">
                            {m.year}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="grants">
        <h2>Grants & Funding</h2>

        <div class="flex flex-col gap-4">
            {
                funding.map((f) => (
                    <div class="flex justify-between items-start gap-4">
                        <div>
                            <div class="item-title">
                                {f.title}
                            </div>
                            <div class="item-meta">
                                <em>{f.funder}</em>
                            </div>
                            <div class="item-meta mt-[0.15rem]">
                                {f.role}
                            </div>
                        </div>
                        <div class="item-date">
                            {f.year}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="service">
        <h2>Service - Reviewer</h2>
        <div class="flex flex-col gap-4">
            {
                service.map((s) => (
                    <div class="flex justify-between items-start gap-4">
                        <div class="item-title">
                            {s.venue}
                        </div>
                        <div class="item-date">
                            {s.years}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>
</Layout>

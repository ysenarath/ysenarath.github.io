---
import Layout from "../layouts/Layout.astro";
import {
    researchOverview,
    dissertationThemes,
    otherThemes,
    futureDirections,
} from "../data/research";

const slug = (s: string) =>
    s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<Layout title="Research">
    <div class="[&_p]:max-w-none">
        <header class="mt-8 mb-8">
            <h1 class="sr-only">Research</h1>
            <p class="lede mb-0">{researchOverview}</p>
        </header>

        <div>
            <h2 id={slug("Dissertation Research")} class="mt-0">Dissertation Research</h2>
            <p class="text-ink-muted -mt-[0.25rem] mb-2">
                Knowledge-Guided Continual Learning (KGCL) for modeling evolving
                human behavioral patterns in online social media data streams. Three
                levels of knowledge integration:
            </p>
            {
                dissertationThemes.map((theme) => (
                    <section>
                        <h3 id={slug(theme.title)}>{theme.title}</h3>
                        {theme.paragraphs.map((p) => (
                            <p>{p}</p>
                        ))}
                    </section>
                ))
            }

            <h2 id={slug("Other Research")}>Other Research</h2>
            {
                otherThemes.map((theme) => (
                    <section>
                        <h3 id={slug(theme.title)}>{theme.title}</h3>
                        {theme.paragraphs.map((p) => (
                            <p>{p}</p>
                        ))}
                    </section>
                ))
            }

            <h2 id={slug("Future Directions")}>Future Directions</h2>
            {
                futureDirections.map((dir) => (
                    <section>
                        <h3 id={slug(dir.title)}>{dir.title}</h3>
                        <p>{dir.paragraph}</p>
                    </section>
                ))
            }
        </div>
    </div>
</Layout>

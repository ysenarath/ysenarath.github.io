---
import Layout from "../layouts/Layout.astro";
import { tutorials, assistantships, instructorships } from "../data/teaching";
---

<Layout title="Teaching">
    <h1 class="mt-8 mb-6">Teaching</h1>
    <h2>Tutorials</h2>
    <div class="flex flex-col gap-6">
        {
            tutorials.map((t) => (
                <div class="flex justify-between items-start gap-4">
                    <div>
                        <div class="item-title">
                            {t.title}
                        </div>
                        <div class="item-meta">
                            <em>{t.event}</em>
                            {t.location && <span> · {t.location}</span>}
                            {t.status && (
                                <span class="tag">
                                    {t.status}
                                </span>
                            )}
                            {t.presenters && (
                                <>
                                    <br />
                                    <span class="italic">
                                        with{" "}
                                        {t.presenters
                                            .filter(
                                                (p) =>
                                                    p !==
                                                    "Yasas Senarath Wijesuriya",
                                            )
                                            .join(", ")}
                                    </span>
                                </>
                            )}
                        </div>
                    </div>
                    <div>
                        {t.year && <span class="item-date">{t.year}</span>}
                    </div>
                </div>
            ))
        }
    </div>

    <h2>Teaching Assistantships</h2>
    <div class="flex flex-col gap-6">
        {
            assistantships.map((a) => (
                <div class="flex justify-between items-start gap-4">
                    <div>
                        <div class="item-title">
                            {a.role}
                        </div>
                        <div class="item-meta">
                            <em>{a.institution}</em>
                            {a.location && <span>, {a.location}</span>}
                        </div>
                        {a.courses && a.courses.length > 0 && (
                            <ul class="list-none p-0 mt-1 item-meta mb-0">
                                {a.courses.map((course) => (
                                    <li class="mb-0.5">{course}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                    <div>
                        {a.period && (
                            <span class="item-date">
                                {a.period}
                            </span>
                        )}
                    </div>
                </div>
            ))
        }
    </div>

    <h2>Visiting Instructor</h2>
    <div class="flex flex-col gap-6">
        {
            instructorships.map((i) => (
                <div class="flex justify-between items-start gap-4">
                    <div>
                        <div class="item-title">
                            {i.role}
                        </div>
                        <div class="item-meta">
                            <em>{i.institution}</em>
                            {i.location && <span>, {i.location}</span>}
                        </div>
                        {i.courses && i.courses.length > 0 && (
                            <ul class="list-none p-0 mt-1 item-meta mb-0">
                                {i.courses.map((course) => (
                                    <li class="mb-0.5">{course}</li>
                                ))}
                            </ul>
                        )}
                    </div>
                    <div>
                        {i.period && (
                            <span class="item-date">
                                {i.period}
                            </span>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</Layout>

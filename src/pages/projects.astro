---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
---

<Layout title="Projects">
    <h1 class="mt-8 mb-8">Projects</h1>
    <div class="flex flex-col">
        {
            projects.map((project) => (
                <article class="border-t border-ink pt-5 pb-10">
                    <div class="flex justify-between items-start gap-4 mt-0 mb-3">
                        <h3 class="mt-0 mb-0 text-[1.5rem]">
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener"
                                class="text-ink-strong no-underline hover:underline"
                            >
                                {project.name}
                            </a>
                        </h3>
                        <a
                            href={project.url}
                            target="_blank"
                            rel="noopener"
                            class="btn-outline shrink-0"
                        >
                            Visit ↗
                        </a>
                    </div>
                    <p class="lede !text-[1.15rem] mb-3">
                        {project.description}
                    </p>
                    <p>{project.detail}</p>
                    <div>
                        <img
                            src={project.image}
                            alt={project.name}
                            class="h-auto w-full max-w-[36rem] my-6 bg-white p-3 border border-border rounded-[2px]"
                        />
                    </div>
                    {project.refs.length > 0 && (
                        <ul class="list-none p-0 mt-3 item-meta border-t border-border pt-3 mb-0">
                            {project.refs.map((ref) => (
                                <li class="mb-1">
                                    <span class="text-ink-ghost">
                                        ↗&nbsp;&nbsp;
                                    </span>
                                    {ref.url ? (
                                        <a
                                            href={ref.url}
                                            target="_blank"
                                            rel="noopener"
                                            class="no-underline hover:underline"
                                        >
                                            {ref.title}
                                        </a>
                                    ) : (
                                        ref.title
                                    )}
                                    . <em>{ref.venue}</em>, {ref.year}.
                                </li>
                            ))}
                        </ul>
                    )}
                </article>
            ))
        }
    </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
---

<Layout title="Projects">
    <h1 class="mt-8 mb-6">Projects</h1>
    <div class="flex flex-col">
        {
            projects.map((project) => (
                <article class="with-rail gap-y-4 border-t border-ink pt-5 pb-10">
                    <h3 class="mt-0 mb-0 text-h2 max-w-measure">
                        <a
                            href={project.url}
                            target="_blank"
                            rel="noopener"
                            class="text-ink-strong no-underline hover:underline"
                        >
                            {project.name}
                        </a>
                    </h3>

                    <aside class="rail lg:pt-1 max-lg:order-last">
                        <a
                            href={project.url}
                            target="_blank"
                            rel="noopener"
                            class="btn-outline justify-between w-full max-w-[16rem]"
                        >
                            Visit <span aria-hidden="true">↗</span>
                        </a>
                        {project.refs.length > 0 && (
                            <ul class="list-none p-0 m-0 item-meta border-t border-border pt-3">
                                {project.refs.map((ref) => (
                                    <li class="mb-2 leading-[1.45]">
                                        {ref.url ? (
                                            <a
                                                href={ref.url}
                                                target="_blank"
                                                rel="noopener"
                                                class="no-underline hover:underline"
                                            >{ref.title}</a>
                                        ) : (
                                            ref.title
                                        )}. <em>{ref.venue}</em>, {ref.year}.
                                    </li>
                                ))}
                            </ul>
                        )}
                    </aside>

                    <div class="min-w-0 max-w-measure">
                        <p class="font-serif text-title leading-[1.45] mb-3">
                            {project.description}
                        </p>
                        <p>{project.detail}</p>
                        <img
                            src={project.image}
                            alt={project.name}
                            class="h-auto w-full mt-6 mb-0 bg-white p-3 border border-border rounded-[2px]"
                        />
                    </div>
                </article>
            ))
        }
    </div>
</Layout>

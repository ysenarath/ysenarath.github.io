---
const pathname = Astro.url.pathname;
const isActive = (p: string) =>
    p === "/" ? pathname === "/" : pathname.startsWith(p);

const links = [
    { href: "/research", label: "Research" },
    { href: "/publications", label: "Publications" },
    { href: "/projects", label: "Projects" },
    { href: "/news", label: "News" },
];
---

<nav
    id="main-nav"
    class="border-b border-border bg-white sticky top-0 z-20"
    aria-label="Main navigation"
>
    <div
        class="max-w-[800px] mx-auto flex flex-wrap items-center justify-between"
    >
        <a
            href="/"
            aria-label="Home"
            class="font-sans text-sm font-semibold text-ink-strong no-underline py-[0.85rem] tracking-[0.01em] shrink-0 hover:text-link"
        >
            <span class="hidden sm:inline">Yasas Senarath Wijesuriya</span>
            <span class="sm:hidden">Home</span>
        </a>

        <button
            id="nav-toggle"
            class="sm:hidden p-2 -mr-1 text-ink-muted hover:text-ink-strong transition-colors"
            aria-expanded="false"
            aria-controls="nav-links"
            aria-label="Toggle navigation"
        >
            <svg
                id="icon-open"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <ul
            id="nav-links"
            class="list-none m-0 p-0 hidden sm:flex flex-col sm:flex-row sm:flex-wrap w-full sm:w-auto border-t sm:border-t-0 border-border pb-2 sm:pb-0"
        >
            {
                links.map(({ href, label }) => (
                    <li>
                        <a
                            href={href}
                            data-label={label}
                            class={`nav-link block px-3 py-[0.85rem] no-underline font-sans text-[0.825rem] tracking-[0.01em] transition-colors duration-100 max-sm:py-2 ${
                                isActive(href)
                                    ? "text-ink-strong font-semibold"
                                    : "text-ink-muted hover:text-link"
                            }`}
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a
                    href="/curriculum-vitae.pdf"
                    target="_blank"
                    rel="noopener"
                    data-label="CV"
                    class="nav-link block px-3 py-[0.85rem] no-underline text-ink-muted font-sans text-[0.825rem] tracking-[0.01em] transition-colors duration-100 hover:text-link max-sm:py-2"
                >
                    CV
                </a>
            </li>
        </ul>
    </div>
</nav>

<style>
    .nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    @media (max-width: 639px) {
        .nav-link {
            align-items: flex-start;
        }
    }

    .nav-link::after {
        content: attr(data-label);
        font-weight: 600;
        height: 0;
        visibility: hidden;
        overflow: hidden;
        pointer-events: none;
        user-select: none;
    }
</style>

<script>
    const toggle = document.getElementById("nav-toggle");
    const navLinks = document.getElementById("nav-links");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        navLinks?.classList.toggle("hidden");
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
    });
</script>

---
const pathname = Astro.url.pathname;
const isActive = (p: string) =>
    p === "/" ? pathname === "/" : pathname.startsWith(p);

const links = [
    { href: "/research", label: "Research" },
    { href: "/publications", label: "Publications" },
    { href: "/projects", label: "Projects" },
    { href: "/news", label: "News" },
];
---

<nav
    id="main-nav"
    class="border-b border-border bg-paper sticky top-0 z-20"
    aria-label="Main navigation"
>
    <div
        class="max-w-page mx-auto px-4 flex flex-wrap items-center justify-between"
    >
        <a
            href="/"
            aria-label="Home"
            class="font-serif text-title text-ink-strong no-underline py-[0.75rem] shrink-0 hover:text-link"
        >
            <span class="hidden sm:inline">Yasas Senarath Wijesuriya</span>
            <span class="sm:hidden">Home</span>
        </a>

        <div class="flex items-center sm:order-last">
        <button
            id="theme-toggle"
            class="theme-toggle p-2 text-ink-muted hover:text-ink-strong cursor-pointer sm:-mr-2"
            aria-label="Dark mode"
            aria-pressed="false"
            title="Toggle dark mode"
        >
            <!-- moon: shown in light mode -->
            <svg
                class="dark:hidden"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <!-- sun: shown in dark mode -->
            <svg
                class="hidden dark:block"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                ></path>
            </svg>
        </button>
        <button
            id="nav-toggle"
            class="sm:hidden p-2 -mr-1 text-ink-muted hover:text-ink-strong"
            aria-expanded="false"
            aria-controls="nav-links"
            aria-label="Toggle navigation"
        >
            <svg
                id="icon-open"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="hidden"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        </div>

        <ul
            id="nav-links"
            class="list-none m-0 p-0 hidden sm:flex flex-col sm:flex-row sm:flex-wrap w-full sm:w-auto sm:ml-auto border-t sm:border-t-0 border-border pb-2 sm:pb-0"
        >
            {
                links.map(({ href, label }) => (
                    <li>
                        <a
                            href={href}
                            data-label={label}
                            class={`nav-link block px-3 py-[0.85rem] no-underline font-sans text-small max-sm:py-2 ${
                                isActive(href)
                                    ? "text-ink-strong underline underline-offset-[0.35em]"
                                    : "text-ink-muted hover:text-link"
                            }`}
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a
                    href="/curriculum-vitae.pdf"
                    target="_blank"
                    rel="noopener"
                    data-label="CV"
                    class="nav-link block px-3 py-[0.85rem] no-underline text-ink-muted font-sans text-small hover:text-link max-sm:py-2"
                >
                    CV
                </a>
            </li>
        </ul>
    </div>
</nav>

<style>
    /* Needs the theme script; without JS the site just follows the OS. */
    .theme-toggle {
        display: none;
    }

    :global(html[data-theme]) .theme-toggle {
        display: inline-flex;
    }

    .nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    @media (max-width: 639px) {
        .nav-link {
            align-items: flex-start;
        }
    }

    .nav-link::after {
        content: attr(data-label);
        font-weight: 400;
        height: 0;
        visibility: hidden;
        overflow: hidden;
        pointer-events: none;
        user-select: none;
    }
</style>

<script>
    import { bindThemeToggle } from "../lib/theme";

    const toggle = document.getElementById("nav-toggle");
    const navLinks = document.getElementById("nav-links");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        navLinks?.classList.toggle("hidden");
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
    });

    bindThemeToggle(document.getElementById("theme-toggle"));
</script>

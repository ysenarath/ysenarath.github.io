---
import Nav from "../components/Nav.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    /** Use the full container width (publications); other pages keep a reading column. */
    wide?: boolean;
}

const {
    title,
    description = "Academic portfolio of Yasas Senarath Wijesuriya, PhD at George Mason University.",
    wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <title>{title} — Yasas Senarath Wijesuriya</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
        />
        <slot name="head" />
    </head>
    <body class="min-h-screen flex flex-col overflow-y-scroll">
        <Nav />
        <div class="flex-1">
            <slot name="hero" />
            <slot name="page-nav" />
            <main class="max-w-page mx-auto px-4 py-4">
                {wide ? <slot /> : <div class="max-w-measure"><slot /></div>}
            </main>
        </div>
        <footer class="border-t border-border-soft mt-16">
            <div
                class="max-w-page mx-auto px-4 pt-8 pb-12 text-small text-ink-faint"
            >
                Yasas Senarath Wijesuriya &middot; George Mason University
                &middot; 2026
            </div>
        </footer>
    </body>
</html>
